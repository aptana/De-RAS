// Windows version resource (generated per executable by CMake).
#include <winver.h>
@DERAS_RC_ICON@
VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "De-RAS Project"
            VALUE "FileDescription", "@DERAS_RC_DESCRIPTION@"
            VALUE "FileVersion", "@PROJECT_VERSION@.0"
            VALUE "InternalName", "@DERAS_RC_NAME@"
            VALUE "LegalCopyright", "De-RAS. Not affiliated with HEC or USACE."
            VALUE "OriginalFilename", "@DERAS_RC_NAME@.exe"
            VALUE "ProductName", "De-RAS"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
